# TestForge 后端环境配置模板（复制为 .env 使用；.env 不入库）
# 全部键可省略——省略时用零配置默认值（SQLite + 开发密钥），仅开发演示可用

# 数据库：默认零配置 SQLite；联调/生产切 PostgreSQL（先起 deploy/docker-compose.yml）
# DATABASE_URL=postgresql+psycopg://testforge:testforge@localhost:5432/testforge
DATABASE_URL=sqlite:///./testforge.db

# 安全：生产必须注入随机长密钥（≥32 字节），并轮换默认种子账号密码
SECRET_KEY=change-me-to-a-long-random-secret
TOKEN_EXPIRE_MINUTES=720

# 验证码：内部部署可关（关闭后登录不校验验证码）
CAPTCHA_ENABLED=true
CAPTCHA_TTL_SECONDS=180

# CORS：前端开发端口
CORS_ORIGINS=["http://localhost:5173"]
